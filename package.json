{
  "name": "vitek-plugin",
  "version": "0.2.1-beta",
  "description": "Vite plugin for file-based HTTP API generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/public/plugin.js",
      "types": "./dist/public/plugin.d.ts"
    },
    "./response": {
      "import": "./dist/public/response.js",
      "types": "./dist/public/response.d.ts"
    },
    "./errors": {
      "import": "./dist/public/errors.js",
      "types": "./dist/public/errors.d.ts"
    },
    "./validation": {
      "import": "./dist/public/validation.js",
      "types": "./dist/public/validation.d.ts"
    },
    "./introspection": {
      "import": "./dist/public/introspection.js",
      "types": "./dist/public/introspection.d.ts"
    },
    "./testing": {
      "import": "./dist/public/testing.js",
      "types": "./dist/public/testing.d.ts"
    },
    "./scheduler": {
      "import": "./dist/public/scheduler.js",
      "types": "./dist/public/scheduler.d.ts"
    },
    "./events": {
      "import": "./dist/public/events.js",
      "types": "./dist/public/events.d.ts"
    },
    "./generators": {
      "import": "./dist/public/generators.js",
      "types": "./dist/public/generators.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "dev": "concurrently \"pnpm:dev:tsc\" \"pnpm:docs:dev\"",
    "dev:tsc": "tsc --watch",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:socket": "node scripts/e2e-socket.mjs",
    "bench": "node scripts/bench.mjs",
    "example:bench": "node scripts/bench.mjs --with-example",
    "examples:build": "bash examples/build-all.sh",
    "examples:test": "bash examples/run-all-tests.sh",
    "examples:build-and-test": "bash examples/build-and-test.sh",
    "check": "pnpm i && pnpm run build && pnpm test && pnpm run examples:build-and-test && pnpm run test:e2e && pnpm run test:e2e:socket && pnpm run example:bench",
    "changeset": "changeset",
    "release": "pnpm -r run build && pnpm exec changeset publish"
  },
  "keywords": [
    "vite",
    "plugin",
    "api",
    "file-based",
    "routing"
  ],
  "author": "Victor Bicudo <victor.mbicudo@gmail.com> (https://github.com/martinsbicudo)",
  "license": "MIT",
  "homepage": "https://github.com/martinsbicudo/vitek-plugin#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinsbicudo/vitek-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/martinsbicudo/vitek-plugin/issues"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "connect": "^3.7.0",
    "zod": "^3.23.0",
    "esbuild": "^0.24.0",
    "magic-string": "^0.30.0",
    "serve-static": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/connect": "^3.4.0",
    "@types/node": "^20.0.0",
    "@types/serve-static": "^1.15.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitepress": "^1.0.0",
    "vitest": "^4.0.18"
  },
  "bin": {
    "vitek": "./dist/cli/cli.js",
    "vitek-serve": "./dist/cli/serve.js"
  }
}
