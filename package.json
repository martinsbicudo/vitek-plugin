{
    "name": "vitek-plugin",
    "version": "0.1.2-beta.1",
    "description": "Vite plugin for file-based HTTP API generation",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "concurrently \"pnpm:dev:tsc\" \"pnpm:docs:dev\"",
        "dev:tsc": "tsc --watch",
        "prepublishOnly": "npm run build",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [
        "vite",
        "plugin",
        "api",
        "file-based",
        "routing"
    ],
    "author": "Victor Bicudo <victor.mbicudo@gmail.com> (https://github.com/martinsbicudo)",
    "license": "MIT",
    "homepage": "https://github.com/martinsbicudo/vitek-plugin#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/martinsbicudo/vitek-plugin.git"
    },
    "bugs": {
        "url": "https://github.com/martinsbicudo/vitek-plugin/issues"
    },
    "peerDependencies": {
        "vite": "^5.0.0"
    },
    "dependencies": {
        "connect": "^3.7.0",
        "esbuild": "^0.24.0",
        "serve-static": "^1.16.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/connect": "^3.4.0",
        "@types/node": "^20.0.0",
        "@types/serve-static": "^1.15.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.0.18",
        "concurrently": "^9.0.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vitepress": "^1.0.0",
        "vitest": "^4.0.18"
    },
    "bin": {
        "vitek-serve": "./dist/cli/serve.js"
    }
}
