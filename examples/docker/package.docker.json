{
  "name": "vitek-docker-example",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build && cp vitek.config.mjs dist/",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "start": "vitek-serve --port=5173 --host=0.0.0.0 --trust-proxy",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitek-plugin": "file:./vitek-plugin-0.2.1-beta.tgz",
    "vitest": "^4.0.0"
  }
}
