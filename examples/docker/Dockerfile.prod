# Stage 1: build
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY . .
COPY package.docker.json package.json
RUN pnpm install
RUN pnpm run build

# Stage 2: serve with vitek-serve
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY . .
COPY package.docker.json package.json
RUN pnpm install

COPY --from=builder /app/dist ./dist

EXPOSE 5173

CMD ["pnpm", "run", "start"]
